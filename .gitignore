# Secrets — .env holds ANTHROPIC_API_KEY in plaintext.
# .env.* catches backups and variants (.env.bak, .env.local) that would
# otherwise slip past a bare '.env' rule while still holding the key.
.env
*.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Evaluation output — regenerated by harness.py / report.py
evaluation/results/

# Test documents — bulky binaries. The small JSON question sets stay tracked,
# so evaluation/golden/ still documents what each document contains.
data/**/*.png
data/**/*.pdf
data/**/*.jpg
data/**/*.jpeg
data/golden/
data/rendered/

# Diagram exports — regenerate from docs/workflow.html
docs/*.png

# Session data — contains UNREDACTED originals
/tmp/contextguard-agentic/
sessions/

# OS
.DS_Store
Thumbs.db

# Local tool permissions — machine-specific, not shared config
.claude/settings.local.json
